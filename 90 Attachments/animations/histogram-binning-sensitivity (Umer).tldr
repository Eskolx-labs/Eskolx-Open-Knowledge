        "type": "text",
        "parentId": "page:page",
        "index": "a00086",
        "x": 40,
        "y": 62,
        "rotation": 0,
        "props": {
          "text": "One sample, never modified: seed 20261105, n = 240, 0.82 N(40, 8) + 0.18 N(51, 2.2). The narrow population sits 1.4 core widths out. Bar heights share one scale so the only thing that changes is the width.",
          "font": "draw",
          "size": "m",
          "color": "grey",
          "textAlign": "start",
          "verticalAlign": "start",
          "w": 1000,
          "autoSize": false,
          "scale": 1,
