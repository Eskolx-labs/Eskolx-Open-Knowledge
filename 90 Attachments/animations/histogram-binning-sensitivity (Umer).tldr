          "text": "A histogram is a density estimate: the same 240 values, three bin rules",
          "font": "draw",
          "size": "xl",
          "color": "black",
          "textAlign": "start",
          "verticalAlign": "start",
          "w": 1000,
          "autoSize": false,
          "scale": 1,
