"m","font":"sans","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"STEP 6  Bins k = ceil((max - min) / h)"}]},{"type":"paragraph","content":[{"type":"text","text":"Round UP so the bins cover the whole range."}]}]}},"typeName":"shape"},{"x":1290,"y":1920,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:t7","type":"geo","parentId":"page:page","index":"aQ","props":{"geo":"rectangle","dash":"solid","url":"","w":185,"h":190,"growY":0,"scale":1,"flipX":false,"flipY":false,"labelColor":"black","color":"yellow","fill":"semi","size":"m","font":"sans","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"edges"}]},{"type":"paragraph","content":[{"type":"text","text":"2, 5, 8, 11, 14"}]}]}},"typeName":"shape"},{"x":1200,"y":332,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:s7","type":"geo","parentId":"page:page","index":"aE","props":{"geo":"rectangle","dash":"solid","url":"","w":520,"h":152,"growY":0,"scale":1,"flipX":false,"flipY":false,"labelColor":"black","color":"yellow","fill":"semi","size":"m","font":"sans","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"STEP 7  Real step = (max - min) / k"}]},{"type":"paragraph","content":[{"type":"text","text":"A little less than h. All k bins are equal."}]}]}},"typeName":"shape"},{"x":1505,"y":1920,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:t8","type":"geo","parentId":"page:page","index":"aR","props":{"geo":"rectangle","dash":"solid","url":"","w":185,"h":190,"growY":0,"scale":1,"flipX":false,"flipY":false,"labelColor":"black","color":"green","fill":"semi","size":"m","font":"sans","align":"middle","verticalAlign":"middle","richText":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"counts"}]},{"type":"paragraph","