      "meta": {},
      "typeName": "shape",
      "type": "text",
      "x": 0,
      "y": 650,
      "props": {
        "color": "black",
        "size": "s",
        "font": "mono",
        "textAlign": "start",
        "w": 420,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Hand table for 2 4 4 4 5 5 7 9"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "n  x  d      m      S"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1  2  2      2      0"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "2  4  2      3      2"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "3  4  1      3.33   2.67"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "4  4  0.67   3.5    3"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "5  5  1.5    3.8    4.8"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "6  5  1.2    4      6"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "7  7  3      4.43   13.71"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "8  9  4.57   5      32"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "variance = 32/7 = 4.571"
                }
              ]
            }
          ]
        },
        "scale": 1,
        "autoSize": false
      },
      "id": "shape:s12",
      "index": "aEkFU"
    },
    {
      "parentId": "page:page",
      "rotation": 0,
      "isLocked": false,
